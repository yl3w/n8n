# Deployment-specific values kept out of git. Copy to .env.vars and fill in:
#   cp .env.vars.example .env.vars
# Loaded by pyinfra/inventory*.py, pulumi/__main__.py and pulumi-coolify/__main__.py.
# Real environment variables with the same names take precedence.

# The n8n VPS: hostname set on the machine (pyinfra system.py) and its public addresses
VPS_HOSTNAME=n8n
VPS_IPV4=<vps-ipv4>
VPS_IPV6=<vps-ipv6>

# Human admin account on the VPS (SSH key + sudo password)
ADMIN_USER=<admin-user>
